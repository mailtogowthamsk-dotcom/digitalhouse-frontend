# SPA + canonical host for admin (avoid www vs non-www CORS)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /digitalhouse/admin/

  # www → bare domain (same host as website + API)
  RewriteCond %{HTTP_HOST} ^www\.konguvettuvagounder\.com$ [NC]
  RewriteRule ^ https://konguvettuvagounder.com%{REQUEST_URI} [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /digitalhouse/admin/index.html [L]
</IfModule>
